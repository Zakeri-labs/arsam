# Copy to .env.local and fill in. Never commit real values.
# All of these are server-only secrets — do NOT prefix any of them with NEXT_PUBLIC_.

# Supabase project URL and service-role (or sb_secret_) key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Random string of at least 32 characters used to sign admin sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs every admin out.
SESSION_SECRET=

# General manager password (at least 10 characters). Unset = the account is disabled.
# Other staff accounts are created in the admin panel ("مدیریت دسترسی‌ها").
ADMIN_PASSWORD=
